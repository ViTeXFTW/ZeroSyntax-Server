{
	"compilerOptions": {
		"target": "es2020",
		"lib": ["es2020"],
		"module": "commonjs",
		"moduleResolution": "node",
		"sourceMap": true,
		"strict": true,
		"outDir": "out",
		"rootDir": ".",
		"downlevelIteration": true,
		"noEmitOnError": true,
		"noEmit": false,
		"sourceRoot": "./src",
		"resolveJsonModule": true,
		"esModuleInterop": true
	},
	"include": ["src/**/*", "test/**/*", "src/utils/quickfix/Algorithms.ts"],
	"exclude": ["node_modules", ".vscode-test", "out"]
}